# --- Server-side (Vercel project settings → Environment Variables). Never commit real values. ---
# GoHighLevel Private Integration token (Settings → Private Integrations).
# Scopes needed: contacts.write, contacts.readonly, opportunities.write, locations/customFields.readonly
GHL_PRIVATE_TOKEN=
# CCM sub-account (location) ID
GHL_LOCATION_ID=QKI3AUqCPx7cdgcAH6iu
# Sales Lead Pipeline → New Lead (Growth Compass Hot/Warm leads become opportunities here)
GHL_PIPELINE_ID=kC5OhXO4nLX2aw7a9VRH
GHL_PIPELINE_STAGE_ID=cbd9cba9-a0f0-4f9a-a901-c2c48f0424f0
# Optional: a GHL Workflow "Inbound Webhook" trigger URL. Every submission is also forwarded here
# so you can fire emails, SMS, team alerts and tasks from a workflow.
GHL_INBOUND_WEBHOOK_URL=

# --- Client-side (optional) ---
# Static hosting with no serverless function? Point forms straight at a GHL inbound webhook instead.
VITE_GHL_WEBHOOK_URL=
# Override the API route if you host the function elsewhere.
VITE_LEAD_ENDPOINT=/api/lead
